------------------------------------------------------------------
-- LIVE FPS | PING TAG (optional)
-- Enabled = true  -> the tag is shown and updates every Interval seconds
-- Enabled = false -> the tag is NOT created and NO loop / RenderStepped connection runs at all
-- Colors accept a hex string ("#4ADE80") or a Color3. They can also be changed in Settings > FPS | Ping Tag.
------------------------------------------------------------------
local StatsConfig = {
    Enabled = true,
    Icon = "solar:cpu-bolt-bold",
    Interval = 0.5,
    Colors = {
        Good = "#4ADE80",   -- healthy
        Okay = "#FBBF24",   -- so-so
        Bad = "#F87171",    -- bad
    },
    Thresholds = {
        FpsBad = 30,        -- below this FPS = Bad
        FpsOkay = 50,       -- below this FPS = Okay
        PingBad = 250,      -- above this ping = Bad
        PingOkay = 120,     -- above this ping = Okay
    },
}

local function ToColor3(Value, Fallback)
    if typeof(Value) == "Color3" then
        return Value
    end

    if type(Value) == "string" then
        local Ok, Result = pcall(Color3.fromHex, Value)

        if Ok and Result then
            return Result
        end
    end

    return Fallback or Color3.new(1, 1, 1)
end

local StatsTag
local StatsOn = false
local StatsRun = 0
local Frames, LastTick, LastLevel = 0, os.clock(), nil
local FrameConn

local function GetPing()
    local Ok, Value = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)

    return Ok and math.floor(Value + 0.5) or 0
end

-- While the tag is running this reads the live counter. When it is off nothing runs in the background,
-- so FPS is sampled on demand over a few frames (only when a button asks for it).
local function GetFPS()
    if StatsOn then
        return math.floor(Frames / math.max(os.clock() - LastTick, 0.001) + 0.5)
    end

    local Start = os.clock()

    for _ = 1, 10 do
        RunService.RenderStepped:Wait()
    end

    return math.floor(10 / math.max(os.clock() - Start, 0.001) + 0.5)
end

local function GetLevel(Fps, Ping)
    local T = StatsConfig.Thresholds

    if Fps < T.FpsBad or Ping > T.PingBad then
        return "Bad"
    elseif Fps < T.FpsOkay or Ping > T.PingOkay then
        return "Okay"
    end

    return "Good"
end

local function ApplyStatsColor(Level)
    if not StatsTag then
        return
    end

    LastLevel = Level

    pcall(function()
        StatsTag:SetColor(ToColor3(StatsConfig.Colors[Level], Color3.new(1, 1, 1)))
    end)
end

local function StopStats()
    StatsOn = false
    StatsRun += 1

    if FrameConn then
        FrameConn:Disconnect()
        FrameConn = nil
    end

    if StatsTag then
        pcall(function()
            StatsTag:Destroy()
        end)

        StatsTag = nil
    end

    LastLevel = nil
end

local function StartStats()
    if StatsOn then
        return
    end

    StatsOn = true
    StatsRun += 1

    local Run = StatsRun

    Frames, LastTick, LastLevel = 0, os.clock(), nil

    StatsTag = Window:Tag({
        Title = "-- FPS | --ms",
        Icon = StatsConfig.Icon,
        Color = ToColor3(StatsConfig.Colors.Good, Color3.new(1, 1, 1)),
        MinWidth = 96,
    })

    FrameConn = RunService.RenderStepped:Connect(function()
        Frames += 1
    end)

    task.spawn(function()
        while StatsOn and Run == StatsRun do
            task.wait(StatsConfig.Interval)

            if not (StatsOn and Run == StatsRun) then
                break
            end

            local Now = os.clock()
            local Fps = math.floor(Frames / math.max(Now - LastTick, 0.001) + 0.5)

            Frames, LastTick = 0, Now

            local Ping = GetPing()
            local Level = GetLevel(Fps, Ping)

            pcall(function()
                StatsTag:SetTitle(Fps .. " FPS | " .. Ping .. "ms")
            end)

            if Level ~= LastLevel then
                ApplyStatsColor(Level)
            end
        end
    end)
end

if StatsConfig.Enabled then
    StartStats()
end

