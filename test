        local Status

        if Character and Humanoid and Root then
            Status = "Character, Humanoid and root part are available."
        elseif Character then
            Status = "Character loaded, but one or more parts are missing."
        else
            Status = "Character is not currently loaded."
        end

        Toolkit:Notify({
            Title = "Character Check",
            Content = Status,
            Icon = "solar:user-check-bold",
            Duration = 4,
        })
    end,
})

DeviceInfo:Button({
    Title = "Check Core Services",
    Desc = "Verify access to common Roblox services",
    Icon = "solar:shield-check-bold",
    Text = "Inspect",
    Callback = function()
        local ServiceNames = {
            "Players",
            "RunService",
            "Stats",
            "UserInputService",
            "HttpService",
            "Workspace",
        }

        local Available = 0

        for _, ServiceName in ipairs(ServiceNames) do
            local Success = pcall(function()
                game:GetService(ServiceName)
            end)

            if Success then
                Available += 1
            end
        end

        Toolkit:Notify({
            Title = "Service Check",
            Content = tostring(Available) .. "/" .. tostring(#ServiceNames) .. " services accessible.",
            Icon = "solar:shield-check-bold",
            Type = Available == #ServiceNames and "success" or "warn",
            Duration = 4,
        })
    end,
})

